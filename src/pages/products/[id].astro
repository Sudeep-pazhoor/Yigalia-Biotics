---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { products } from '../../data/products';

export async function getStaticPaths() {
  return products.map(product => ({
    params: { id: product.id },
    props: { product }
  }));
}

const { product } = Astro.props;
const relatedProducts = products.filter(p => p.category === product.category && p.id !== product.id).slice(0, 3);

// SEO-optimized meta description
const seoDescription = `${product.name} - ${product.composition}. ${product.description} Used for ${product.uses}. Quality pharmaceutical product by Yigaia Biotics.`;

// Structured data for product
const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Drug",
  "name": product.name,
  "description": product.description,
  "image": `https://yigaiabiotics.com${product.image}`,
  "manufacturer": {
    "@type": "Organization",
    "name": "Yigaia Biotics"
  },
  "activeIngredient": product.composition,
  "dosageForm": "Tablet/Capsule",
  "administrationRoute": "Oral",
  "clinicalPharmacology": product.uses,
  "category": product.category
};

// Breadcrumb schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://yigaiabiotics.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Products",
      "item": "https://yigaiabiotics.com/products"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": product.name,
      "item": `https://yigaiabiotics.com/products/${product.id}`
    }
  ]
};
---

<Layout 
  title={`${product.name} - ${product.composition} | Yigaia Biotics`}
  description={seoDescription}
  image={product.image}
  type="product"
  keywords={product.keywords || `${product.name}, ${product.composition}, ${product.category}, pharmaceutical, medicine, ${product.uses}, Yigaia Biotics, Mumbai`}
>
  <Fragment slot="head">
    <!-- Additional SEO meta tags -->
    <meta name="keywords" content={product.keywords || `${product.name}, ${product.composition}, ${product.category}, pharmaceutical, medicine, ${product.uses}`} />
    <link rel="canonical" href={`https://yigaiabiotics.com/products/${product.id}`} />
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <Header />
  
  <!-- Product Detail -->
  <section class="product-detail">
    <div class="container">
      <a href="/products" class="back-link">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to Products
      </a>
      
      <div class="row mt-5">
        <div class="col-lg-6 mb-4 mb-lg-0">
          <div class="product-image-container" id="imageContainer">
            <img 
              src={product.image} 
              alt={`${product.name} - ${product.composition} - ${product.category} by Yigaia Biotics`}
              title={`${product.name} - ${product.uses}`}
              class="detail-image" 
              id="productImage"
              loading="eager"
              width="600"
              height="500"
            />
            <div class="zoom-hint">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                <path d="M6.5 12a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zM13 6.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0z"/>
                <path d="M10.344 11.742c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1 6.538 6.538 0 0 1-1.398 1.4z"/>
                <path fill-rule="evenodd" d="M6.5 3a.5.5 0 0 1 .5.5V6h2.5a.5.5 0 0 1 0 1H7v2.5a.5.5 0 0 1-1 0V7H3.5a.5.5 0 0 1 0-1H6V3.5a.5.5 0 0 1 .5-.5z"/>
              </svg>
              Click to view fullscreen
            </div>
          </div>
        </div>
        
        <div class="col-lg-6">
          <div class="product-details">
            <span class="product-category-badge">{product.category}</span>
            <h1 class="product-title">{product.name}</h1>
            
            <div class="detail-section">
              <h3 class="detail-heading">Composition</h3>
              <p class="detail-text">{product.composition}</p>
            </div>
            
            <div class="detail-section">
              <h3 class="detail-heading">Description</h3>
              <p class="detail-text">{product.description}</p>
            </div>
            
            <div class="detail-section">
              <h3 class="detail-heading">Uses</h3>
              <p class="detail-text">{product.uses}</p>
            </div>
            
            <div class="detail-section">
              <h3 class="detail-heading">Dosage</h3>
              <p class="detail-text">{product.dosage}</p>
            </div>
            
            <div class="detail-section">
              <div class="important-note">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <div>
                  <strong>Important:</strong> This medication should be taken only as prescribed by a qualified healthcare professional. Do not self-medicate.
                </div>
              </div>
            </div>
            
            <div class="action-buttons">
              <a href="/contact" class="btn btn-primary-custom">Inquire About This Product</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Fullscreen Modal -->
  <div class="image-modal" id="imageModal">
    <button class="modal-close" id="closeModal" aria-label="Close fullscreen image">
      <svg width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
        <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854Z"/>
      </svg>
    </button>
    <img 
      src={product.image} 
      alt={`${product.name} - ${product.composition} - Full size product image`}
      title={product.name}
      class="modal-image" 
      id="modalImage"
      loading="lazy"
    />
  </div>

  <!-- Related Products -->
  {relatedProducts.length > 0 && (
    <section class="related-products section-padding">
      <div class="container">
        <h2 class="section-title text-center mb-5">Related Products</h2>
        <div class="row">
          {relatedProducts.map(related => (
            <div class="col-lg-4 col-md-6 mb-4">
              <a href={`/products/${related.id}`} class="product-card">
                <div class="product-image-wrapper">
                  <img 
                    src={related.image} 
                    alt={`${related.name} - ${related.composition} - ${related.category}`}
                    title={related.name}
                    class="product-image"
                    loading="lazy"
                    width="400"
                    height="250"
                  />
                  <div class="product-overlay">
                    <span class="view-details">View Details →</span>
                  </div>
                </div>
                <div class="product-info">
                  <span class="product-category">{related.category}</span>
                  <h3 class="product-name">{related.name}</h3>
                  <p class="product-composition">{related.composition}</p>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />
</Layout>

<style>
  .product-detail {
    padding: 150px 0 80px;
    background: var(--bg-dark);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-gray);
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .back-link:hover {
    color: var(--primary-green);
    transform: translateX(-5px);
  }

  .product-image-container {
    background: rgba(0, 0, 0, 0.95);
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    position: sticky;
    top: 120px;
    border: 1px solid rgba(255, 255, 255, 0.03);
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
  }

  .product-image-container:hover {
    transform: scale(1.02);
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.4);
    border-color: var(--primary-green);
  }

  .detail-image {
    width: 100%;
    height: 500px;
    object-fit: contain;
    display: block;
  }

  .zoom-hint {
    position: absolute;
    bottom: 20px;
    right: 20px;
    background: rgba(25, 167, 0, 0.9);
    color: white;
    padding: 10px 15px;
    border-radius: 8px;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 8px;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .product-image-container:hover .zoom-hint {
    opacity: 1;
  }

  .zoom-hint svg {
    width: 18px;
    height: 18px;
  }

  /* Fullscreen Modal */
  .image-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.95);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    animation: fadeIn 0.3s ease;
  }

  .image-modal.active {
    display: flex;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .modal-image {
    max-width: 90%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 10px;
    box-shadow: 0 20px 80px rgba(0, 0, 0, 0.8);
    animation: zoomIn 0.3s ease;
  }

  @keyframes zoomIn {
    from {
      transform: scale(0.8);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .modal-close {
    position: absolute;
    top: 30px;
    right: 30px;
    background: var(--primary-red);
    border: none;
    color: white;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 10000;
  }

  .modal-close:hover {
    background: rgba(189, 29, 5, 0.8);
    transform: rotate(90deg) scale(1.1);
  }

  .product-details {
    padding-left: 20px;
  }

  .product-category-badge {
    display: inline-block;
    background: rgba(25, 167, 0, 0.1);
    color: var(--primary-green);
    padding: 8px 20px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 15px;
  }

  .product-title {
    font-size: 2.5rem;
    margin-bottom: 30px;
    line-height: 1.2;
  }

  .detail-section {
    margin-bottom: 30px;
    padding-bottom: 30px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .detail-section:last-of-type {
    border-bottom: none;
  }

  .detail-heading {
    font-size: 1.2rem;
    color: var(--primary-green);
    margin-bottom: 12px;
    font-weight: 600;
  }

  .detail-text {
    color: var(--text-gray);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
  }

  .important-note {
    display: flex;
    gap: 15px;
    background: rgba(189, 29, 5, 0.1);
    border: 1px solid var(--primary-red);
    border-radius: 10px;
    padding: 20px;
    color: var(--text-gray);
    line-height: 1.6;
  }

  .important-note svg {
    color: var(--primary-red);
    flex-shrink: 0;
  }

  .important-note strong {
    color: var(--text-light);
  }

  .action-buttons {
    margin-top: 40px;
  }

  .related-products {
    background: var(--bg-dark-secondary);
  }

  .product-card {
    display: block;
    background: rgba(0, 0, 0, 0.9);
    border-radius: 15px;
    overflow: hidden;
    transition: all 0.4s ease;
    border: 1px solid rgba(255, 255, 255, 0.03);
    height: 100%;
  }

  .product-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 40px rgba(25, 167, 0, 0.2);
    border-color: var(--primary-green);
  }

  .product-image-wrapper {
    position: relative;
    height: 250px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
    padding: 10px;
  }

  .product-card:hover .product-image {
    transform: scale(1.1);
  }

  .product-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(25, 167, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .product-card:hover .product-overlay {
    opacity: 1;
  }

  .view-details {
    color: white;
    font-weight: 600;
    font-size: 1.1rem;
  }

  .product-info {
    padding: 25px;
  }

  .product-category {
    display: inline-block;
    color: var(--primary-green);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }

  .product-name {
    font-size: 1.3rem;
    margin-bottom: 10px;
    color: var(--text-light);
  }

  .product-composition {
    color: var(--text-gray);
    font-size: 0.9rem;
    margin: 0;
  }

  @media (max-width: 991px) {
    .product-title {
      font-size: 2rem;
    }

    .product-details {
      padding-left: 0;
      margin-top: 30px;
    }

    .product-image-container {
      position: relative;
      top: 0;
      padding: 15px;
    }

    .detail-image {
      height: auto;
      min-height: 350px;
      max-height: 500px;
      object-fit: contain;
      object-position: center;
    }

    .modal-close {
      top: 15px;
      right: 15px;
      width: 40px;
      height: 40px;
    }

    .modal-image {
      max-width: 95%;
      max-height: 80vh;
    }
  }

  @media (max-width: 576px) {
    .product-image-container {
      padding: 10px;
      border-radius: 15px;
    }

    .detail-image {
      height: auto;
      min-height: 300px;
      max-height: 450px;
      width: 100%;
      object-fit: contain;
      object-position: center;
    }

    .zoom-hint {
      bottom: 10px;
      right: 10px;
      padding: 8px 12px;
      font-size: 0.75rem;
    }

    .zoom-hint svg {
      width: 16px;
      height: 16px;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animate product details
  gsap.from('.product-image-container', {
    x: -50,
    opacity: 0,
    duration: 0.8,
    ease: 'power3.out'
  });

  gsap.from('.product-details > *', {
    x: 50,
    opacity: 0,
    duration: 0.6,
    stagger: 0.1,
    ease: 'power3.out'
  });

  // Animate related products
  gsap.utils.toArray('.related-products .product-card').forEach((card: any, index) => {
    gsap.from(card, {
      scrollTrigger: {
        trigger: card,
        start: 'top 90%',
      },
      y: 50,
      opacity: 0,
      duration: 0.6,
      delay: index * 0.1,
    });
  });

  // Fullscreen image modal
  const imageContainer = document.getElementById('imageContainer');
  const productImage = document.getElementById('productImage');
  const imageModal = document.getElementById('imageModal');
  const closeModal = document.getElementById('closeModal');
  const modalImage = document.getElementById('modalImage');

  // Open modal when clicking image
  imageContainer?.addEventListener('click', () => {
    imageModal?.classList.add('active');
    document.body.style.overflow = 'hidden';
  });

  // Close modal when clicking close button
  closeModal?.addEventListener('click', (e) => {
    e.stopPropagation();
    imageModal?.classList.remove('active');
    document.body.style.overflow = 'auto';
  });

  // Close modal when clicking outside the image
  imageModal?.addEventListener('click', (e) => {
    if (e.target === imageModal) {
      imageModal.classList.remove('active');
      document.body.style.overflow = 'auto';
    }
  });

  // Close modal with Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && imageModal?.classList.contains('active')) {
      imageModal.classList.remove('active');
      document.body.style.overflow = 'auto';
    }
  });
</script>
