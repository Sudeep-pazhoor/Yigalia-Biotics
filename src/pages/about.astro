---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="About Us - Yigaia Biotics" 
  description="Learn about Yigaia Biotics, your trusted partner in quality pharmaceutical products since 2021"
>
  <Header />
  
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1 class="page-title">About Yigaia Biotics</h1>
      <p class="page-subtitle">Building trust through quality and innovation</p>
    </div>
  </section>

  <!-- Company Story -->
  <section class="company-story section-padding">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6 mb-4 mb-lg-0">
          <div class="story-image">
            <img src="/Logo New.jpeg" alt="Yigaia Biotics" />
          </div>
        </div>
        <div class="col-lg-6">
          <span class="section-tag">Our Story</span>
          <h2 class="section-title">Committed to Healthcare Excellence</h2>
          <p class="story-text">Founded in 2021 in Mumbai, Yigaia Biotics emerged with a clear vision: to provide healthcare professionals and patients with pharmaceutical products they can trust. Our journey began with a commitment to quality, innovation, and unwavering dedication to improving healthcare outcomes.</p>
          <p class="story-text">Over the years, we have built strong relationships with doctors, distributors, and healthcare institutions, earning their trust through consistent quality and reliable service. Every product we offer undergoes rigorous quality checks to ensure it meets the highest pharmaceutical standards.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="values-section section-padding">
    <div class="container">
      <div class="text-center mb-5">
        <span class="section-tag">Our Values</span>
        <h2 class="section-title">What Drives Us</h2>
      </div>
      
      <div class="row">
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="value-card">
            <div class="value-icon">
              <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h3 class="value-title">Quality Assurance</h3>
            <p class="value-description">Every product meets stringent quality standards and regulatory requirements. We never compromise on quality.</p>
          </div>
        </div>
        
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="value-card">
            <div class="value-icon">
              <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
              </svg>
            </div>
            <h3 class="value-title">Trust & Reliability</h3>
            <p class="value-description">Building lasting relationships with healthcare professionals through consistent, reliable service and support.</p>
          </div>
        </div>
        
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="value-card">
            <div class="value-icon">
              <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <h3 class="value-title">Innovation</h3>
            <p class="value-description">Continuously introducing new pharmaceutical solutions to meet evolving healthcare needs.</p>
          </div>
        </div>
        
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="value-card">
            <div class="value-icon">
              <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <h3 class="value-title">Professional Excellence</h3>
            <p class="value-description">Expert guidance and support for healthcare providers, ensuring optimal patient outcomes.</p>
          </div>
        </div>
        
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="value-card">
            <div class="value-icon">
              <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h3 class="value-title">Accessibility</h3>
            <p class="value-description">Making quality pharmaceutical products accessible to healthcare providers and patients across regions.</p>
          </div>
        </div>
        
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="value-card">
            <div class="value-icon">
              <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
            </div>
            <h3 class="value-title">Patient Care</h3>
            <p class="value-description">Putting patient health and wellbeing at the center of everything we do.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="why-choose section-padding">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6 mb-4 mb-lg-0">
          <span class="section-tag">Why Choose Us</span>
          <h2 class="section-title">Your Trusted Pharmaceutical Partner</h2>
          
          <div class="choose-list">
            <div class="choose-item">
              <div class="choose-number">01</div>
              <div class="choose-content">
                <h4>Comprehensive Product Range</h4>
                <p>From antibiotics to chronic disease management, we offer a wide spectrum of pharmaceutical solutions.</p>
              </div>
            </div>
            
            <div class="choose-item">
              <div class="choose-number">02</div>
              <div class="choose-content">
                <h4>Quality Certifications</h4>
                <p>All our products comply with pharmaceutical regulations and quality standards.</p>
              </div>
            </div>
            
            <div class="choose-item">
              <div class="choose-number">03</div>
              <div class="choose-content">
                <h4>Expert Support Team</h4>
                <p>Dedicated professionals ready to assist healthcare providers with product information and support.</p>
              </div>
            </div>
            
            <div class="choose-item">
              <div class="choose-number">04</div>
              <div class="choose-content">
                <h4>Timely Delivery</h4>
                <p>Efficient distribution network ensuring products reach you when you need them.</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="col-lg-6">
          <div class="stats-grid">
            <div class="stat-box">
              <div class="stat-value">20+</div>
              <div class="stat-label">Quality Products</div>
            </div>
            <div class="stat-box">
              <div class="stat-value">5+</div>
              <div class="stat-label">Years of Trust</div>
            </div>
            <div class="stat-box">
              <div class="stat-value">100%</div>
              <div class="stat-label">Quality Assured</div>
            </div>
            <div class="stat-box">
              <div class="stat-value">24/7</div>
              <div class="stat-label">Support Available</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">Partner With Yigaia Biotics</h2>
        <p class="cta-text">Join healthcare professionals who trust us for quality pharmaceutical solutions</p>
        <a href="/contact" class="btn btn-primary-custom btn-lg">Contact Us Today</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .page-header {
    padding: 150px 0 80px;
    text-align: center;
    background: linear-gradient(135deg, rgba(25, 167, 0, 0.1) 0%, rgba(189, 29, 5, 0.05) 100%);
  }

  .page-title {
    font-size: 3rem;
    margin-bottom: 15px;
  }

  .page-subtitle {
    font-size: 1.3rem;
    color: var(--text-gray);
  }

  .company-story {
    background: var(--bg-dark);
  }

  .story-image {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
  }

  .story-image img {
    width: 100%;
    border-radius: 20px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .story-text {
    color: var(--text-gray);
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 20px;
    text-align: justify;
  }

  .values-section {
    background: var(--bg-dark-secondary);
  }

  .value-card {
    background: rgba(10, 10, 10, 0.4);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 40px 30px;
    border-radius: 15px;
    text-align: center;
    height: 100%;
    border: 1px solid rgba(25, 167, 0, 0.3);
    transition: all 0.3s ease;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.6);
  }

  .value-card:hover {
    transform: translateY(-10px);
    border-color: var(--primary-green);
    box-shadow: 0 15px 40px rgba(25, 167, 0, 0.3);
    background: rgba(10, 10, 10, 0.6);
  }

  .value-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 25px;
    background: rgba(25, 167, 0, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary-green);
  }

  .value-title {
    font-size: 1.3rem;
    margin-bottom: 15px;
  }

  .value-description {
    color: var(--text-gray);
    line-height: 1.6;
    margin: 0;
  }

  .why-choose {
    background: var(--bg-dark);
  }

  .choose-list {
    display: flex;
    flex-direction: column;
    gap: 30px;
    margin-top: 30px;
  }

  .choose-item {
    display: flex;
    gap: 20px;
  }

  .choose-number {
    width: 50px;
    height: 50px;
    background: rgba(25, 167, 0, 0.1);
    border: 2px solid var(--primary-green);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary-green);
    font-weight: 700;
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .choose-content h4 {
    font-size: 1.2rem;
    margin-bottom: 8px;
  }

  .choose-content p {
    color: var(--text-gray);
    margin: 0;
    line-height: 1.6;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .stat-box {
    background: var(--bg-dark-card);
    padding: 40px 20px;
    border-radius: 15px;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
  }

  .stat-box:hover {
    border-color: var(--primary-green);
    transform: scale(1.05);
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--primary-green);
    margin-bottom: 10px;
  }

  .stat-label {
    color: var(--text-gray);
    font-size: 0.95rem;
  }

  .cta-section {
    padding: 100px 0;
    background: linear-gradient(135deg, rgba(25, 167, 0, 0.1) 0%, rgba(189, 29, 5, 0.1) 100%);
  }

  .cta-content {
    text-align: center;
  }

  .cta-title {
    font-size: 2.5rem;
    margin-bottom: 20px;
  }

  .cta-text {
    font-size: 1.2rem;
    color: var(--text-gray);
    margin-bottom: 30px;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animate value cards
  gsap.utils.toArray('.value-card').forEach((card: any, index) => {
    gsap.from(card, {
      scrollTrigger: {
        trigger: card,
        start: 'top 85%',
      },
      y: 50,
      opacity: 0,
      duration: 0.6,
      delay: index * 0.1,
    });
  });

  // Animate choose items
  gsap.utils.toArray('.choose-item').forEach((item: any, index) => {
    gsap.from(item, {
      scrollTrigger: {
        trigger: item,
        start: 'top 85%',
      },
      x: -50,
      opacity: 0,
      duration: 0.6,
      delay: index * 0.15,
    });
  });

  // Animate stat boxes
  gsap.utils.toArray('.stat-box').forEach((box: any, index) => {
    gsap.from(box, {
      scrollTrigger: {
        trigger: box,
        start: 'top 85%',
      },
      scale: 0.8,
      opacity: 0,
      duration: 0.5,
      delay: index * 0.1,
    });
  });
</script>
