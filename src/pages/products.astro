---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { products } from '../data/products';

const categories = [...new Set(products.map(p => p.category))];

// Structured data for product listing
const productListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": products.map((product, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Drug",
      "name": product.name,
      "description": product.description,
      "image": `https://yigaiabiotics.com${product.image}`,
      "url": `https://yigaiabiotics.com/products/${product.id}`,
      "manufacturer": {
        "@type": "Organization",
        "name": "Yigaia Biotics"
      }
    }
  }))
};
---

<Layout 
  title="Pharmaceutical Products - Quality Medicines | Yigaia Biotics" 
  description="Browse our comprehensive range of quality pharmaceutical products including antibiotics, pain relief, diabetes management, and more. Trusted medicines by Yigaia Biotics."
  keywords="pharmaceutical products, medicines, antibiotics, pain relief, diabetes medication, calcium supplements, antidiabetic drugs, Yigaia Biotics, quality medicines India"
>
  <Fragment slot="head">
    <!-- BreadcrumbList Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://yigaiabiotics.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Products",
          "item": "https://yigaiabiotics.com/products"
        }
      ]
    })} />
    
    <!-- Product List Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(productListSchema)} />
  </Fragment>
  <Header />
  
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <div class="header-content">
        <div class="header-text">
          <h1 class="page-title">Our Products</h1>
          <p class="page-subtitle">Comprehensive pharmaceutical solutions for modern healthcare</p>
        </div>
        <div class="search-box">
          <div class="input-group">
            <input 
              type="text" 
              class="form-control search-input" 
              id="searchInput"
              placeholder="Search products..."
              aria-label="Search products"
            />
            <button class="btn search-btn" type="button">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Products Grid -->
  <section class="products-grid section-padding">
    <div class="container">
      <div class="row" id="productsContainer">
        {products.map((product, index) => (
          <div class="col-lg-4 col-md-6 mb-4 product-item" data-category={product.category}>
            <a href={`/products/${product.id}`} class="product-card">
              <div class="product-image-wrapper">
                <img 
                  src={product.image} 
                  alt={`${product.name} - ${product.composition} - ${product.category} by Yigaia Biotics`}
                  title={`${product.name} - ${product.uses}`}
                  class="product-image" 
                  loading={index < 6 ? "eager" : "lazy"}
                  width="400"
                  height="280"
                />
                <div class="product-overlay">
                  <span class="view-details">View Details →</span>
                </div>
              </div>
              <div class="product-info">
                <span class="product-category">{product.category}</span>
                <h3 class="product-name">{product.name}</h3>
                <p class="product-composition">{product.composition}</p>
                <div class="product-uses">
                  <strong>Uses:</strong> {product.uses}
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .page-header {
    padding: 150px 0 60px;
    background: linear-gradient(135deg, rgba(25, 167, 0, 0.1) 0%, rgba(189, 29, 5, 0.05) 100%);
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
  }

  .header-text {
    flex: 1;
    text-align: left;
  }

  .page-title {
    font-size: 3rem;
    margin-bottom: 15px;
  }

  .page-subtitle {
    font-size: 1.3rem;
    color: var(--text-gray);
  }

  .search-box {
    min-width: 350px;
  }

  .input-group {
    display: flex;
  }

  .search-input {
    background: rgba(10, 10, 10, 0.6);
    border: 2px solid rgba(25, 167, 0, 0.2);
    border-right: none;
    color: var(--text-light);
    padding: 14px 20px;
    font-size: 1rem;
    border-radius: 10px 0 0 10px;
  }

  .search-input:focus {
    background: rgba(10, 10, 10, 0.8);
    border-color: var(--primary-green);
    color: var(--text-light);
    outline: none;
    box-shadow: none;
  }

  .search-input::placeholder {
    color: var(--text-gray);
    opacity: 0.7;
  }

  .search-btn {
    background: var(--primary-green);
    border: 2px solid var(--primary-green);
    color: white;
    padding: 14px 20px;
    border-radius: 0 10px 10px 0;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .search-btn:hover {
    background: var(--primary-green-light);
    border-color: var(--primary-green-light);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(25, 167, 0, 0.3);
  }

  .search-btn svg {
    width: 20px;
    height: 20px;
  }

  .products-grid {
    background: var(--bg-dark);
    min-height: 60vh;
    padding: 60px 0 80px;
  }

  .product-item {
    transition: all 0.3s ease;
    opacity: 1;
  }

  .product-item.hidden {
    display: none;
  }

  .product-card {
    display: block;
    background: rgba(10, 10, 10, 0.4);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 15px;
    overflow: hidden;
    transition: all 0.4s ease;
    border: 1px solid rgba(25, 167, 0, 0.3);
    height: 100%;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.6);
  }

  .product-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 40px rgba(25, 167, 0, 0.3);
    border-color: var(--primary-green);
    background: rgba(10, 10, 10, 0.6);
  }

  .product-image-wrapper {
    position: relative;
    height: 280px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
    padding: 10px;
  }

  .product-card:hover .product-image {
    transform: scale(1.1);
  }

  .product-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(25, 167, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .product-card:hover .product-overlay {
    opacity: 1;
  }

  .view-details {
    color: white;
    font-weight: 600;
    font-size: 1.1rem;
  }

  .product-info {
    padding: 25px;
  }

  .product-category {
    display: inline-block;
    color: var(--primary-green);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }

  .product-name {
    font-size: 1.3rem;
    margin-bottom: 10px;
    color: var(--text-light);
  }

  .product-composition {
    color: var(--text-gray);
    font-size: 0.9rem;
    margin-bottom: 15px;
  }

  .product-uses {
    color: var(--text-gray);
    font-size: 0.85rem;
    line-height: 1.5;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 15px;
  }

  .product-uses strong {
    color: var(--text-light);
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }

    .page-subtitle {
      font-size: 1rem;
    }

    .page-header {
      padding: 120px 0 40px;
    }

    .header-content {
      flex-direction: column;
      gap: 25px;
    }

    .header-text {
      text-align: center;
    }

    .search-box {
      min-width: 100%;
      width: 100%;
    }

    .products-grid {
      padding: 40px 0 60px;
    }

    .product-image-wrapper {
      height: 250px;
    }

    .product-image {
      padding: 15px;
      object-fit: contain;
    }

    .product-info {
      padding: 20px;
    }
  }

  @media (max-width: 576px) {
    .product-image-wrapper {
      height: 220px;
    }

    .product-image {
      padding: 10px;
    }

    .product-card:hover .product-image {
      transform: scale(1.05);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  // Wait for page to load before animating
  document.addEventListener('DOMContentLoaded', () => {
    const productItems = document.querySelectorAll('.product-item');
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    
    // Set initial state
    gsap.set(productItems, { opacity: 1, y: 0 });
    
    // Animate on load
    gsap.from(productItems, {
      y: 30,
      opacity: 0,
      duration: 0.6,
      stagger: 0.08,
      ease: 'power3.out',
      clearProps: 'all'
    });

    // Search functionality
    searchInput?.addEventListener('input', (e) => {
      const searchTerm = (e.target as HTMLInputElement).value.toLowerCase();
      
      productItems.forEach((item) => {
        const productName = item.querySelector('.product-name')?.textContent?.toLowerCase() || '';
        const productCategory = item.querySelector('.product-category')?.textContent?.toLowerCase() || '';
        const productComposition = item.querySelector('.product-composition')?.textContent?.toLowerCase() || '';
        
        const matches = productName.includes(searchTerm) || 
                       productCategory.includes(searchTerm) || 
                       productComposition.includes(searchTerm);
        
        if (matches || searchTerm === '') {
          gsap.to(item, {
            opacity: 1,
            scale: 1,
            duration: 0.3,
            onStart: () => {
              item.classList.remove('hidden');
            }
          });
        } else {
          gsap.to(item, {
            opacity: 0,
            scale: 0.9,
            duration: 0.2,
            onComplete: () => {
              item.classList.add('hidden');
            }
          });
        }
      });
    });
  });
</script>
