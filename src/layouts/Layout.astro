---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  keywords?: string;
}

const { 
  title, 
  description = "Yigalia Biotics - Trusted experts in quality pharmaceutical products since 2021. Offering comprehensive range of medicines for various therapeutic needs in Mumbai, India.", 
  image = "/Logo New.jpeg",
  type = "website",
  keywords = "pharmaceutical, medicine, healthcare, Mumbai, quality products, Yigalia Biotics, pharmacy, drugs, medical supplies"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://yigaliabiotics.com");
const siteUrl = Astro.site || "https://yigaliabiotics.com";
const fullImageUrl = new URL(image, siteUrl).toString();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="Yigalia Biotics" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="canonical" href={canonicalURL} />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Yigalia Biotics" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Yigalia Biotics - Quality Pharmaceutical Products" />
  <meta property="og:locale" content="en_IN" />
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullImageUrl} />
  <meta name="twitter:image:alt" content="Yigalia Biotics - Quality Pharmaceutical Products" />
  
  <!-- Favicons - Multiple sizes for better compatibility -->
  <link rel="icon" type="image/jpeg" href="/Logo New.jpeg" />
  <link rel="shortcut icon" type="image/jpeg" href="/Logo New.jpeg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/Logo New.jpeg" />
  <link rel="icon" type="image/jpeg" sizes="32x32" href="/Logo New.jpeg" />
  <link rel="icon" type="image/jpeg" sizes="16x16" href="/Logo New.jpeg" />
  <meta name="msapplication-TileImage" content="/Logo New.jpeg" />
  <meta name="msapplication-TileColor" content="#19a700" />
  <meta name="theme-color" content="#000000" />
  <link rel="manifest" href="/site.webmanifest" />
  
  <!-- Business Information -->
  <meta name="geo.region" content="IN-MH" />
  <meta name="geo.placename" content="Mumbai" />
  <meta name="geo.position" content="19.0760;72.8777" />
  <meta name="ICBM" content="19.0760, 72.8777" />
  
  <title>{title}</title>
  
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  
  <!-- Organization Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Yigalia Biotics",
    "url": siteUrl,
    "logo": fullImageUrl,
    "description": "Trusted experts in quality pharmaceutical products",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Mumbai",
      "addressRegion": "Maharashtra",
      "addressCountry": "IN"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "yigaliabiotics@gmail.com",
      "contactType": "Customer Service",
      "areaServed": "IN",
      "availableLanguage": ["English", "Hindi"]
    },
    "sameAs": [
      "https://www.instagram.com/yigaliabiotics"
    ],
    "foundingDate": "2021"
  })} />

  <!-- WebSite Schema with SearchAction -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Yigalia Biotics",
    "url": siteUrl,
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": `${siteUrl}/products?q={search_term_string}`
      },
      "query-input": "required name=search_term_string"
    }
  })} />

  <!-- LocalBusiness Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MedicalBusiness",
    "name": "Yigalia Biotics",
    "url": siteUrl,
    "logo": fullImageUrl,
    "image": fullImageUrl,
    "description": "Trusted experts in quality pharmaceutical products since 2021. Offering comprehensive range of medicines for various therapeutic needs.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Mumbai",
      "addressRegion": "Maharashtra",
      "addressCountry": "IN"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 19.0760,
      "longitude": 72.8777
    },
    "email": "yigaliabiotics@gmail.com",
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
        "opens": "09:00",
        "closes": "18:00"
      }
    ],
    "priceRange": "$$",
    "sameAs": [
      "https://www.instagram.com/yigaliabiotics"
    ]
  })} />
  
  <!-- Additional head content from pages -->
  <slot name="head" />
</head>
<body>
  <slot />
  
  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<style is:global>
  :root {
    --primary-green: rgba(25, 167, 0, 1);
    --primary-green-light: rgba(25, 167, 0, 0.8);
    --primary-red: rgba(189, 29, 5, 1);
    --bg-dark: rgba(0, 0, 0, 1);
    --bg-dark-secondary: rgba(5, 5, 5, 1);
    --bg-dark-card: rgba(10, 10, 10, 0.6);
    --text-light: rgba(255, 255, 255, 0.95);
    --text-gray: rgba(200, 200, 200, 1);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-dark);
    color: var(--text-light);
    overflow-x: hidden;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  .btn-primary-custom {
    background: linear-gradient(135deg, var(--primary-green), var(--primary-green-light));
    border: none;
    color: white;
    padding: 12px 30px;
    border-radius: 8px;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(25, 167, 0, 0.3);
  }

  .btn-primary-custom:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(25, 167, 0, 0.5);
  }

  .section-padding {
    padding: 80px 0;
  }

  /* Glassmorphism effect for cards */
  .glass-card {
    background: rgba(10, 10, 10, 0.4);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(25, 167, 0, 0.2);
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);
  }

  /* Responsive Images */
  img {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    .section-padding {
      padding: 50px 0;
    }
  }
</style>
